{
  "name": "customers",
  "version": "0.0.0-NOT-USED",
  "engines": {
    "node": ">=18.0.0 <24.0.0",
    "yarn": ">=1.22.0 <2",
    "npm": "Please use Yarn instead of NPM to install dependencies"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "git add"
    ],
    "*.scss": [
      "stylelint --fix",
      "git add"
    ],
    "*.{html,json,md,yml,css}": [
      "prettier --write",
      "git add"
    ]
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "test": "ng test",
    "test:ci": "ng test --browsers=ChromeHeadless --watch=false --code-coverage",
    "e2e": "ng e2e",
    "build": "ng build",
    "build:prod": "ng build --base-href=/customers/",
    "lint": "npm run lint:ts && npm run lint:scss",
    "lint:ts": "eslint \"src/**/*.ts\" --fix",
    "lint:scss": "stylelint \"src/**/*.scss\" --fix",
    "predeploy": "npm run build:prod",
    "deploy": "ng deploy",
    "analyze": "ng build --stats-json && webpack-bundle-analyzer dist/customers/stats.json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.1.0",
    "@angular/cdk": "^17.1.0",
    "@angular/common": "^17.1.0",
    "@angular/compiler": "^17.1.0",
    "@angular/core": "^17.1.0",
    "@angular/forms": "^17.1.0",
    "@angular/material": "^17.1.0",
    "@angular/material-moment-adapter": "^17.1.0",
    "@angular/platform-browser": "^17.1.0",
    "@angular/platform-browser-dynamic": "^17.1.0",
    "@angular/router": "^17.1.0",
    "@ng-matero/extensions": "^17.1.2",
    "@ng-matero/extensions-moment-adapter": "^17.1.2",
    "@ngx-formly/core": "^6.2.0",
    "@ngx-formly/material": "^6.2.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "angular-in-memory-web-api": "~0.17.0",
    "apexcharts": "^3.43.0",
    "bootstrap": "^5.3.3",
    "crypto-js": "^4.2.0",
    "google-libphonenumber": "^3.2.42",
    "intl-tel-input": "19",
    "jwt-decode": "^4.0.0",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.41",
    "ngx-bootstrap": "^12.0.0",
    "ngx-intl-tel-input": "^17.0.0",
    "ngx-permissions": "^16.0.1",
    "ngx-progressbar": "^11.1.0",
    "ngx-toastr": "^18.0.0",
    "photoviewer": "^3.9.2",
    "screenfull": "^6.0.2",
    "tslib": "^2.6.0",
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.1.0",
    "@angular-eslint/builder": "^17.2.0",
    "@angular-eslint/eslint-plugin": "^17.2.0",
    "@angular-eslint/template-parser": "^17.2.0",
    "@angular/cli": "^17.1.0",
    "@angular/compiler-cli": "^17.1.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "angular-cli-ghpages": "^2.0.0-beta.1",
    "eslint": "^8.56.0",
    "lint-staged": "^15.2.0",
    "protractor": "~7.0.0",
    "stylelint": "^16.1.0",
    "stylelint-config-recess-order": "^4.4.0",
    "stylelint-config-recommended-scss": "^14.0.0",
    "stylelint-config-standard": "^36.0.0",
    "ts-node": "~10.9.0",
    "typescript": "~5.3.3",
  }
}
