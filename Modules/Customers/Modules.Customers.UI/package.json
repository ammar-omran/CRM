{
  "name": "customers",
  "version": "0.0.0-NOT-USED",
  "engines": {
    "node": ">=22.12.0 <24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "test": "ng test",
    "test:ci": "ng test --browsers=ChromeHeadless --watch=false --code-coverage",
    "e2e": "ng e2e",
    "build": "ng build",
    "build:prod": "ng build --base-href=/customers/",
    "lint": "npm run lint:ts && npm run lint:scss",
    "lint:ts": "eslint \"src/**/*.ts\" --fix",
    "lint:scss": "stylelint \"src/**/*.scss\" --fix",
    "hmr": "ng serve --hmr --disable-host-check",
    "predeploy": "npm run build:prod",
    "deploy": "ng deploy",
    "analyze": "ng build --stats-json && webpack-bundle-analyzer dist/customers/stats.json",
    "postinstall": "node scripts/patch-ngx-intl-tel-input.js || true"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.7",
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/material": "^22.1.7",
    "@angular/material-moment-adapter": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/platform-browser-dynamic": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@ng-matero/extensions": "^22.0.0",
    "@ng-matero/extensions-moment-adapter": "^22.0.0",
    "@ngx-formly/core": "^6.3.12",
    "@ngx-formly/material": "^6.3.12",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "angular-in-memory-web-api": "~0.22.0",
    "apexcharts": "^3.43.0",
    "bootstrap": "^5.3.3",
    "crypto-js": "^4.2.0",
    "google-libphonenumber": "^3.2.42",
    "intl-tel-input": "^19.5.6",
    "jwt-decode": "^4.0.0",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.41",
    "ngx-bootstrap": "^18.1.3",
    "ngx-intl-tel-input": "^17.0.0",
    "ngx-permissions": "^16.0.1",
    "ngx-progressbar": "^11.1.0",
    "ngx-toastr": "^20.0.5",
    "photoviewer": "^3.9.2",
    "rxjs": "~7.8.2",
    "screenfull": "^6.0.2",
    "sha.js": "^2.4.11",
    "tslib": "^2.8.0",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.8",
    "@angular-eslint/builder": "^22.5.0",
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/schematics": "^22.5.0",
    "@angular-eslint/template-parser": "^22.5.0",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@commitlint/cli": "^18.4.0",
    "@commitlint/config-conventional": "^18.4.0",
    "@types/crypto-js": "^4.2.2",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.7.0",
    "@types/sha.js": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "angular-cli-ghpages": "^3.1.0",
    "cpr": "^3.0.1",
    "eslint": "^9.11.0",
    "gulp": "^5.0.1",
    "gulp-each": "^0.5.0",
    "http-proxy-middleware": "^3.0.5",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^15.2.0",
    "parse5": "^7.1.2",
    "prettier": "^3.2.4",
    "protractor": "^3.3.0",
    "rimraf": "^5.0.0",
    "stylelint": "^16.1.0",
    "stylelint-config-recess-order": "^4.4.0",
    "stylelint-config-recommended-scss": "^14.0.0",
    "stylelint-config-standard": "^36.0.0",
    "ts-node": "~10.9.0",
    "typescript": "~6.0.3",
    "webpack-bundle-analyzer": "^4.10.0"
  }
