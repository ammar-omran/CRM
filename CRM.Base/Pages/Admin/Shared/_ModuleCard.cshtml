@model CRM.Base.Modules.Admin.ModuleSummary

<div class="module-card @(!Model.Enabled ? "module-card--disabled" : "")">
    <div class="module-card__header">
        <div class="module-card__title">
            <span class="module-card__icon">▦</span>
            <div>
                <div class="module-card__name">@Model.DisplayName</div>
                <div class="module-card__id">@Model.ModuleId</div>
            </div>
        </div>
        <partial name="Shared/_StatusBadge" model="@Model" />
    </div>

    <dl class="module-card__meta">
        <div class="module-card__meta-row">
            <dt>Version</dt>
            <dd>@(Model.Version ?? "—")</dd>
        </div>
        <div class="module-card__meta-row">
            <dt>Kind</dt>
            <dd>@Model.Kind</dd>
        </div>
        <div class="module-card__meta-row">
            <dt>Audience</dt>
            <dd>@Model.Audience</dd>
        </div>
        <div class="module-card__meta-row">
            <dt>Base URL</dt>
            <dd class="module-card__url" title="@Model.BaseUrl">@Model.BaseUrl</dd>
        </div>
    </dl>

    <div class="module-card__actions">
        @if (Model.Enabled)
        {
            <form asp-page="/Admin/Index" asp-page-handler="Disable" method="post" class="module-card__form">
                <input type="hidden" asp-for="@Model.ModuleId" name="moduleId" />
                <button type="submit" class="btn btn--warn">Disable</button>
            </form>
        }
        else
        {
            <form asp-page="/Admin/Index" asp-page-handler="Enable" method="post" class="module-card__form">
                <input type="hidden" asp-for="@Model.ModuleId" name="moduleId" />
                <button type="submit" class="btn btn--primary">Enable</button>
            </form>
        }

        <form asp-page="/Admin/Index" asp-page-handler="Remove" method="post"
              class="module-card__form"
              onsubmit="return confirm('Remove module \'@Model.DisplayName\' (@Model.ModuleId) from the platform? This removes it from CRM.Base registration and the gateway, but does not delete its source or deployment.');">
            <input type="hidden" asp-for="@Model.ModuleId" name="moduleId" />
            <button type="submit" class="btn btn--danger">Remove</button>
        </form>
    </div>
</div>
